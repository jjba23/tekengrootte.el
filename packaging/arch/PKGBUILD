pkgname=emacs-tekengrootte
pkgver=0.4.3
pkgrel=1
pkgdesc="Proportionally scaled face sizes for Emacs"
arch=('any')
url="https://github.com/jjba23/tekengrootte.el"
license=('MIT')
depends=('emacs')
makedepends=('emacs')
checkdepends=('emacs')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('90a7eda82c769292674eb2c8d6161b1290f6e5e8526bc49f3d2b0b6a604609c3')

# The forge names the unpacked directory after the repository and the tag, not
# after the tarball ($pkgname-$pkgver), so every step enters it by hand.
_srcdir="$srcdir/tekengrootte.el-$pkgver"

build() {
  cd "$_srcdir"

  emacs -Q --batch -f batch-byte-compile tekengrootte.el
}

check() {
  cd "$_srcdir"

  emacs -Q --batch -L . -L test -l test/tekengrootte-tests.el -f ert-run-tests-batch-and-exit
}

package() {
  cd "$_srcdir"

  install -Dm644 tekengrootte.el "$pkgdir/usr/share/emacs/site-lisp/tekengrootte.el"
  install -Dm644 tekengrootte.elc "$pkgdir/usr/share/emacs/site-lisp/tekengrootte.elc"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.org "$pkgdir/usr/share/doc/$pkgname/README.org"
}
